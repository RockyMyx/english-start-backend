NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english_start?schema=public
POSTGRES_PASSWORD=postgres
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
API_BIND_ADDRESS=0.0.0.0
API_PORT=3000
CORS_ORIGIN=*
DEV_LOGIN_ENABLED=true
SESSION_TTL_DAYS=30
AVATAR_STORAGE_PATH=storage/avatars
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 小程序后台「开发管理 -> 开发设置 -> 消息推送」中的 Token（使用明文模式）
WECHAT_MESSAGE_TOKEN=
# 小程序后台「虚拟支付 -> 基本配置」中的 OfferId 和对应环境 AppKey
WECHAT_VIRTUAL_PAYMENT_OFFER_ID=
WECHAT_VIRTUAL_PAYMENT_APP_KEY=
# 兼容旧部署：仅在 MEMBERSHIP_PAYMENT_MODE 未设置时使用下面的旧商品ID和旧价格
WECHAT_VIRTUAL_PAYMENT_PRODUCT_ID=membership_year
# 微信支付环境独立于业务价格模式：0=现网，1=沙箱；AppKey 必须与它匹配
WECHAT_VIRTUAL_PAYMENT_ENV=1
MEMBERSHIP_PRICE_FEN=9900
# 业务价格模式：test=测试价，live=正式价；留空兼容旧配置
MEMBERSHIP_PAYMENT_MODE=live
# 两套价格单位都是分；修改价格需同步上传、发布相应商品，建议新价格使用新的商品ID
MEMBERSHIP_TEST_PRICE_FEN=100
MEMBERSHIP_TEST_PRODUCT_ID=membership_year_test
MEMBERSHIP_LIVE_PRICE_FEN=9900
MEMBERSHIP_LIVE_PRODUCT_ID=membership_year
MEMBERSHIP_DURATION_DAYS=365
# 可选；商品发布工具默认使用 https://wx.rockyma.online/media/membership-product.png
MEMBERSHIP_PRODUCT_IMAGE_URL=
AZURE_TTS_ENDPOINT=
AZURE_TTS_KEY=
AZURE_TTS_REGION=
AZURE_SPEECH_VOICE=en-US-JennyNeural
# 当前产品统一使用智谱处理判断、出题、图片理解与图片生成
AI_EVALUATION_PROVIDER=zhipu
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_TEXT_MODEL=glm-5.2
ZHIPU_PLATFORM_API_KEY=
ZHIPU_PLATFORM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_VISION_MODEL=glm-4.6v-flash
ZHIPU_IMAGE_MODEL=glm-image
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
