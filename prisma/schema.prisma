generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VocabularySource {
  STARTER
  USER
  LEGACY
}

enum PracticeMode {
  WORD_READING
  WORD_PRONUNCIATION
  LISTEN_CHOOSE_MEANING
  MEANING_CHOOSE_WORD
  WORD_CHOOSE_MEANING
  DICTATION
  SENTENCE
  DIALOGUE_TEXT
  DIALOGUE_VOICE
}

enum LearningResult {
  VIEWED
  CORRECT
  INCORRECT
}

model User {
  id              String             @id @default(uuid())
  wechatOpenId    String             @unique
  nickname        String?
  englishName     String?
  avatarFileName  String?
  dailyScoreGoal  Int                @default(50)
  weeklyGoalDays  Int                @default(5)
  membershipExpiresAt DateTime?
  learnerAgeBand      String?
  gradeLevel          String?
  englishExperience   String?
  learningGoals       String[]           @default([])
  sessions        Session[]
  vocabularyItems VocabularyItem[]
  practiceAttempts PracticeAttempt[]
  wordProgress    WordProgress[]
  dailyCheckIns   DailyCheckIn[]
  reviewItemStates ReviewItemState[]
  dailyPlans      DailyPlan[]
  redeemedMembershipCodes MembershipRedemptionCode[]
  membershipPaymentOrders MembershipPaymentOrder[]
  initialAssessments InitialAssessment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model InitialAssessment {
  id          String                    @id @default(uuid())
  userId      String
  status      String                    @default("IN_PROGRESS")
  difficulty  String                    @default("FOUNDATION")
  level       String?
  scores      Json?
  summary     String?
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     InitialAssessmentAnswer[]
  startedAt   DateTime                  @default(now())
  completedAt DateTime?
  updatedAt   DateTime                  @updatedAt

  @@index([userId, status, startedAt])
}

model InitialAssessmentAnswer {
  id                   String            @id @default(uuid())
  assessmentId         String
  questionKey          String
  dimension            String
  result               String
  answerText           String?
  recognizedText       String?
  score                Float?
  pronunciationScore   Float?
  accuracyScore        Float?
  fluencyScore         Float?
  completenessScore    Float?
  assessment           InitialAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answeredAt           DateTime          @default(now())

  @@unique([assessmentId, questionKey])
  @@index([assessmentId, dimension])
}

model MembershipRedemptionCode {
  id               String   @id @default(uuid())
  codeHash         String   @unique
  codeHint         String
  durationDays     Int      @default(7)
  label            String?
  expiresAt        DateTime?
  redeemedAt       DateTime?
  redeemedByUserId String?
  redeemedBy       User?    @relation(fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([redeemedByUserId, redeemedAt])
  @@index([expiresAt])
}

model MembershipPaymentOrder {
  id            String   @id @default(uuid())
  outTradeNo    String   @unique
  userId        String
  productId     String
  amountFen     Int
  durationDays  Int
  env           Int
  status        String   @default("PENDING")
  transactionId String?
  paidAt        DateTime?
  deliveredAt   DateTime?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model DailyCheckIn {
  id        String   @id @default(uuid())
  userId    String
  dateKey   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, dateKey])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model StarterVocabulary {
  id                String   @id @default(uuid())
  key               String   @unique
  category          String
  english           String
  normalizedEnglish String
  chinese           String
  phonetic          String?
  sortOrder         Int
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category, sortOrder])
}

model VocabularyItem {
  id                String             @id @default(uuid())
  userId            String
  english           String
  normalizedEnglish String
  chinese           String
  phonetic          String?
  source            VocabularySource
  sourceKey         String?
  archivedAt        DateTime?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceAttempts  PracticeAttempt[]
  progress          WordProgress?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([userId, normalizedEnglish])
  @@unique([userId, sourceKey])
  @@index([userId, archivedAt])
}

model SentencePrompt {
  id              String   @id @default(uuid())
  key             String   @unique
  targetWord      String
  promptChinese   String
  referenceAnswer String
  acceptedAnswers String[]
  explanation     String
  sortOrder       Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DialoguePrompt {
  id              String   @id @default(uuid())
  key             String   @unique
  question        String
  questionChinese String
  referenceAnswer String
  acceptedAnswers String[]
  evaluationHint  String
  sortOrder       Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PracticeAttempt {
  id               String          @id @default(uuid())
  userId           String
  vocabularyItemId String?
  mode             PracticeMode
  result           LearningResult
  answerText       String?
  recognizedText   String?
  feedback         String?
  semanticScore    Float?
  pronunciationScore Float?
  accuracyScore    Float?
  fluencyScore     Float?
  completenessScore Float?
  exerciseKey      String?
  promptText       String?
  referenceAnswer  String?
  dailyPlanId      String?
  dailyTaskKey     String?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyItem   VocabularyItem? @relation(fields: [vocabularyItemId], references: [id], onDelete: SetNull)
  dailyPlan        DailyPlan?       @relation(fields: [dailyPlanId], references: [id], onDelete: SetNull)
  occurredAt       DateTime         @default(now())

  @@index([userId, occurredAt])
  @@index([vocabularyItemId])
  @@index([mode, occurredAt])
  @@index([userId, exerciseKey, occurredAt])
  @@index([dailyPlanId, dailyTaskKey, occurredAt])
}

model ReviewItemState {
  id                 String         @id @default(uuid())
  userId             String
  itemType           String
  itemKey            String
  masteredAt         DateTime?
  reviewStage        Int            @default(0)
  intervalDays       Int            @default(0)
  nextReviewAt       DateTime?
  lastReviewedAt     DateTime?
  lastResult         LearningResult?
  lapseCount         Int            @default(0)
  successfulDays     Int            @default(0)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([userId, itemType, itemKey])
  @@index([userId, masteredAt])
  @@index([userId, nextReviewAt])
}

model DailyPlan {
  id               String            @id @default(uuid())
  userId           String
  dateKey          String
  tasks            Json
  completedAt      DateTime?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceAttempts PracticeAttempt[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([userId, dateKey])
  @@index([userId, completedAt])
}

model WordProgress {
  userId           String
  vocabularyItemId String         @unique
  attemptCount     Int            @default(0)
  correctCount     Int            @default(0)
  incorrectCount   Int            @default(0)
  lastPracticedAt  DateTime?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyItem   VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)
  updatedAt        DateTime       @updatedAt

  @@id([userId, vocabularyItemId])
  @@index([vocabularyItemId])
}
